# The build context is the source, not a working copy. Anything generated on a
# developer's machine has to be rebuilt inside the image, or the image ends up
# carrying a cache that describes a different install.

.git
.github
.githooks
.idea
.vscode

node_modules
vendor
public/build

# Generated by a local, dev-dependency install. Baking it into a --no-dev
# image makes the application boot looking for providers that are not there.
bootstrap/cache/*.php

storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
database/*.sqlite

.env
.env.*
!.env.example

coverage.xml
.phpunit.cache
.phpunit.result.cache
