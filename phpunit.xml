<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         cacheDirectory=".phpunit.cache"
>
    <testsuites>
        <!--
            Module suites use a wildcard so a new module is picked up without
            touching this file. That is the same promise config/modules.php makes.
        -->
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
            <directory>app/Modules/*/Tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <directory>app/Modules/*/Tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
        <exclude>
            <directory>app/Modules/*/Tests</directory>
            <!-- Blade templates are not code coverage can speak about. -->
            <directory>app/Modules/*/Resources/views</directory>
        </exclude>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Fixed so the suite runs on a fresh clone with no .env. -->
        <env name="APP_KEY" value="base64:sD2wfUdhIL+bUNEr7qsMMb3BMg0/s51V+D/r7ZEzRD0="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
    </php>
</phpunit>
